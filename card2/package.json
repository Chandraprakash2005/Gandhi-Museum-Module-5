{
  "name": "card2-voices-of-renaissance",
  "version": "1.0.0",
  "description": "Voices of Renaissance - Gandhi Museum Module 5 Card 2",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --dir"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.gandhi.museum.card2",
    "productName": "Card2-Voices-of-Renaissance",
    "directories": {
      "output": "exe"
    },
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "script.js",
      "data.js",
      "kiosk-idle.js",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../assets/Voice model",
        "to": "Voice model"
      }
    ],
    "win": {
      "target": "dir"
    }
  }
}
